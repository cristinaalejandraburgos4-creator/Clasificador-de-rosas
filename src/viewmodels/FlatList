import React, { useState } from 'react';
import { 
  View, 
  Text, 
  TextInput, 
  TouchableOpacity, 
  FlatList, 
  StyleSheet, 
  ActivityIndicator, 
  KeyboardAvoidingView, 
  Platform 
} from 'react-native';
import { useRoseViewModel } from '../viewmodels/useRoseViewModel';

export default function IndexScreen() {
  const { resultado, cargando, error, predecirEspecie } = useRoseViewModel();
  
  // Estados locales para los inputs del formulario
  const [caracteristica1, setCaracteristica1] = useState('');
  const [caracteristica2, setCaracteristica2] = useState('');

  const handleClasificar = () => {
    if (!caracteristica1 || !caracteristica2) return;
    
    // Convertimos los valores a números y los enviamos al ViewModel
    predecirEspecie({
      feature1: parseFloat(caracteristica1),
      feature2: parseFloat(caracteristica2)
    });
  };

  // Preparamos los datos para renderizarlos con FlatList (cumpliendo rúbrica)
  const dataList = resultado ? [resultado] : [];

  return (
    <KeyboardAvoidingView 
      behavior={Platform.OS === 'ios' ? 'padding' : 'height'} 
      style={styles.container}
    >
      <View style={styles.header}>
        <Text style={styles.title}>Clasificador de Rosas 🌹</Text>
        <Text style={styles.subtitle}>Modelo de IA con FastAPI y MVVM</Text>
      </View>

      <View style={styles.form}>
        <TextInput
          style={styles.input}
          placeholder="Valor característica 1 (ej. Longitud)"
          placeholderTextColor="#888"
          keyboardType="numeric"
          value={caracteristica1}
          onChangeText={setCaracteristica1}
        />
        <TextInput
          style={styles.input}
          placeholder="Valor característica 2 (ej. Ancho)"
          placeholderTextColor="#888"
          keyboardType="numeric"
          value={caracteristica2}
          onChangeText={setCaracteristica2}
        />

        <TouchableOpacity 
          style={styles.button} 
          onPress={handleClasificar}
          disabled={cargando}
        >
          <Text style={styles.buttonText}>{cargando ? 'Analizando...' : 'Clasificar Rosa'}</Text>
        </TouchableOpacity>
      </View>

      {cargando && (
        <ActivityIndicator size="large" color="#e91e63" style={styles.loader} />
      )}

      {error && (
        <Text style={styles.errorText}>{error}</Text>
      )}

      {/* Uso obligatorio de FlatList según la rúbrica */}
      <FlatList
        data={dataList}
        keyExtractor={(item, index) => index.toString()}
        renderItem={({ item }) => (
          <View style={styles.card}>
            <Text style={styles.cardTitle}>Resultado de la Predicción:</Text>
            <Text style={styles.cardText}>Especie: <Text style={styles.bold}>{item.especie || item.prediction}</Text></Text>
            <Text style={styles.cardText}>Confianza: <Text style={styles.bold}>{item.confianza ? `${(item.confianza * 100).toFixed(1)}%` : 'N/A'}</Text></Text>
          </View>
        )}
        contentContainerStyle={styles.listContainer}
      />
    </KeyboardAvoidingView>
  );
}

